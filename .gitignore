# Terraform
.terraform/
*.tfstate
*.tfstate.backup
*.tfplan
plan.out
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
# Do NOT ignore .terraform.lock.hcl — it should be committed for reproducible builds

# Sensitive files — NEVER commit
*.tfvars
!*.tfvars.example
.env
.env.*
*.pem
*.key
*.p12
*.pfx
credentials
credentials.*
kubeconfig
kubeconfig.*
aws-credentials

# Generated by scripts/render-ingress.sh from k8s/base/ingress/ingress.yaml.tpl.
# Carries the account ID, ACM certificate ARN and security group ID of whichever
# environment rendered it last; the .tpl is the tracked artifact.
k8s/base/ingress/ingress.yaml

# NOTE_FOR_ME.md — a personal rebuild checklist, deliberately not repo
# documentation. It is written in the first person, it covers dev only, and
# anything the team is meant to read belongs in docs/. Kept on disk rather than
# deleted: it is currently the only rebuild runbook that exists.
NOTE_FOR_ME.md

