        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * sum(rate(http_server_requests_seconds_count{job=\"genai-service\", namespace=~\"$namespace\", status=~\"5..\"}[5m])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"genai-service\", namespace=~\"$namespace\"}[5m])), 0.0001)",
          "legendFormat": ""
        }
      ]
